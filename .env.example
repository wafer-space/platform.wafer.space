# Django Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_ALLOWED_HOSTS=localhost,0.0.0.0,127.0.0.1

# Database
# ------------------------------------------------------------------------------
# For SQLite (default in local development):
# No DATABASE_URL needed, uses db.sqlite3

# For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/wafer_space

# Email Configuration
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Redis (for caching and Celery)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# OAuth Providers
# ------------------------------------------------------------------------------
# GitHub OAuth
# Create app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth
# Create app at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitLab OAuth
# Create app at: https://gitlab.com/-/profile/applications
GITLAB_CLIENT_ID=your_gitlab_client_id_here
GITLAB_CLIENT_SECRET=your_gitlab_client_secret_here

# LinkedIn OAuth
# Create app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Security Settings
# ------------------------------------------------------------------------------
# Force admin to use django-allauth authentication
DJANGO_ADMIN_FORCE_ALLAUTH=False

# Account Settings
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Celery Configuration (optional)
# ------------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
