# Development Environment Configuration for platform.wafer.space

# Django Core Settings
# ------------------------------------------------------------------------------
# Note: systemd EnvironmentFile format - no quotes around values
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
# ------------------------------------------------------------------------------
# No DATABASE_URL needed, uses db.sqlite3 for SQLite (default in local development)

# Email Configuration (Console)
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# OAuth Providers
# ------------------------------------------------------------------------------
# GitHub OAuth Application
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# GitLab OAuth Application
GITLAB_CLIENT_SECRET=YOUR_GITLAB_CLIENT_SECRET

# Google OAuth Application
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# LinkedIn OAuth Application
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET

# Discord OAuth Application
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# API Tokens
# ------------------------------------------------------------------------------
# GitHub API Token (for repository access)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Security Settings
# ------------------------------------------------------------------------------
# Force admin to use django-allauth authentication
DJANGO_ADMIN_FORCE_ALLAUTH=False

# Account Settings
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Celery Configuration
# ------------------------------------------------------------------------------
# Uses sqlite as broker by default (via DATABASE_URL)
# Override if needed: CELERY_BROKER_URL=db+postgresql://user:password@localhost:5432/wafer_space

# Manufacturability Checking
# ------------------------------------------------------------------------------
PRECHECK_DOCKER_IMAGE=ghcr.io/wafer-space/gf180mcu-precheck:latest
PRECHECK_CONCURRENT_LIMIT=4
PRECHECK_PER_USER_LIMIT=1
# Dev default is 5 min (300s), prod/stage default is 12 hours (43200s)
# Uncomment to override the settings default:
# PRECHECK_TIMEOUT_SECONDS=43200
