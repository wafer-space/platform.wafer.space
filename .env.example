# Development Environment Configuration for platform.wafer.space

# Django Core Settings
# ------------------------------------------------------------------------------
# Note: systemd EnvironmentFile format - no quotes around values
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
# ALLOWED_HOSTS host allowlist. Dev/pytest hardcode this in their settings, so
# it is not needed here. On stage/prod it is REQUIRED and read from the
# environment (comma-separated, NO spaces); a missing value fails fast:
# DJANGO_ALLOWED_HOSTS=platform.wafer.space,doc.platform.wafer.space

# Database
# ------------------------------------------------------------------------------
# Local dev: No DATABASE_URL needed, uses db.sqlite3 for SQLite
# Production/Staging: Uses Unix socket connection (no TCP/IP) for security:
# DATABASE_URL=postgres://user:password@/dbname?host=/var/run/postgresql

# Email Configuration (Console)
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# OAuth Providers
# ------------------------------------------------------------------------------
# GitHub OAuth Application
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# GitLab OAuth Application
GITLAB_CLIENT_SECRET=YOUR_GITLAB_CLIENT_SECRET

# Google OAuth Application
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# LinkedIn OAuth Application
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET

# Discord OAuth Application
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# API Tokens
# ------------------------------------------------------------------------------
# GitHub API Token (for repository access)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Security Settings
# ------------------------------------------------------------------------------
# Force admin to use django-allauth authentication
DJANGO_ADMIN_FORCE_ALLAUTH=False

# Account Settings
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Celery Configuration
# ------------------------------------------------------------------------------
# Uses sqlite as broker by default (via DATABASE_URL)
# Production/Staging: Auto-generated from DATABASE_URL using Unix socket
# Format: sqla+postgresql://user:password@/dbname?host=/var/run/postgresql

# Display Settings
# ------------------------------------------------------------------------------
# Deploy target identifier shown in page footer (optional)
DEPLOY_TARGET=local-dev
