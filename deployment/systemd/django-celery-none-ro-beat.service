[Unit]
Description=platform.wafer.space Celery Beat Scheduler (none:ro:beat)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
# DJANGO_SETTINGS_MODULE is set in .env file (auto-detected: stage or prod)
EnvironmentFile=/home/django/platform.wafer.space/.env

# Isolated runtime and log directories (created automatically)
# Sets $RUNTIME_DIRECTORY and $LOGS_DIRECTORY environment variables
RuntimeDirectory=platform.wafer.space-celery-none-ro-beat
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-celery-none-ro-beat
LogsDirectoryMode=0750

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    beat \
    --loglevel=info \
    --logfile=${LOGS_DIRECTORY}/beat.log \
    --pidfile=${RUNTIME_DIRECTORY}/beat.pid \
    --schedule=${RUNTIME_DIRECTORY}/celerybeat-schedule

# Security hardening
# Queue: none:ro:beat - Celery Beat scheduler (schedules tasks, no execution)
# Network: none - no IP network traffic allowed (DB access via Unix socket only)
# Filesystem: ro - read-only access to application
# Intended ports: none (see issue #209)
# RuntimeDirectory and LogsDirectory are auto-excluded from ProtectSystem
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space
IPAddressDeny=any

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
