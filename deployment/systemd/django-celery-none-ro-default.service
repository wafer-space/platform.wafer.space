[Unit]
Description=platform.wafer.space Celery Worker (none:ro:default)
After=network.target postgresql.service django-gunicorn.service
Requires=postgresql.service

[Service]
Type=forking
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
# DJANGO_SETTINGS_MODULE is set in .env file (auto-detected: stage or prod)
EnvironmentFile=/home/django/platform.wafer.space/.env

# Isolated runtime and log directories (created automatically)
# Sets $RUNTIME_DIRECTORY and $LOGS_DIRECTORY environment variables
RuntimeDirectory=platform.wafer.space-celery-none-ro-default
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-celery-none-ro-default
LogsDirectoryMode=0750

PIDFile=/run/platform.wafer.space-celery-none-ro-default/worker.pid

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    worker \
    --loglevel=info \
    --logfile=${LOGS_DIRECTORY}/worker.log \
    --pidfile=${RUNTIME_DIRECTORY}/worker.pid \
    --detach \
    --queues=none:ro:default \
    --hostname=none-ro-default@%h

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Startup timeout - give celery time to write PID file
TimeoutStartSec=30s

# Security hardening
# Queue: none:ro:default - catch-all for unassigned tasks (DB access via Unix socket only)
# Network: none - no IP network traffic allowed
# Filesystem: ro - read-only access to application
# Intended ports: none (see issue #209)
# RuntimeDirectory and LogsDirectory are auto-excluded from ProtectSystem
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space
IPAddressDeny=any

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
