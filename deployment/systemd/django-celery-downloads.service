[Unit]
Description=platform.wafer.space Celery Worker (Downloads)
After=network.target postgresql.service django-gunicorn.service
Requires=postgresql.service

[Service]
Type=forking
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
EnvironmentFile=/home/django/platform.wafer.space/.env
PIDFile=/run/platform.wafer.space/celery-downloads.pid

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    worker \
    --loglevel=info \
    --logfile=/var/log/platform.wafer.space/celery-downloads.log \
    --pidfile=/run/platform.wafer.space/celery-downloads.pid \
    --detach \
    --queues=downloads \
    --hostname=downloads@%h

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Startup timeout - give celery time to write PID file
TimeoutStartSec=30s

# Runtime directory (automatically created on boot)
RuntimeDirectory=platform.wafer.space
RuntimeDirectoryMode=0755

# Security hardening
# Downloads need filesystem write to media directory for downloaded files
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space
ReadWritePaths=/var/log/platform.wafer.space /run/platform.wafer.space /home/django/platform.wafer.space/wafer_space/media

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
