[Unit]
Description=platform.wafer.space Celery Worker (http:rw:downloads)
After=network.target postgresql.service django-gunicorn.service
Requires=postgresql.service

[Service]
Type=forking
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
EnvironmentFile=/home/django/platform.wafer.space/.env

# Isolated runtime and log directories (created automatically)
# Sets $RUNTIME_DIRECTORY and $LOGS_DIRECTORY environment variables
RuntimeDirectory=platform.wafer.space-celery-http-rw-downloads
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-celery-http-rw-downloads
LogsDirectoryMode=0750

PIDFile=${RUNTIME_DIRECTORY}/worker.pid

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    worker \
    --loglevel=info \
    --logfile=${LOGS_DIRECTORY}/worker.log \
    --pidfile=${RUNTIME_DIRECTORY}/worker.pid \
    --detach \
    --queues=http:rw:downloads \
    --hostname=http-rw-downloads@%h

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Startup timeout - give celery time to write PID file
TimeoutStartSec=30s

# Security hardening
# Queue: http:rw:downloads - file download tasks (download_project_file)
# Network: http - HTTP/HTTPS traffic to arbitrary URLs
# Filesystem: rw - writes downloaded files to media directory
# Intended ports: 80, 443, 8080, 8081, 8443 (see issue #209)
# Note: No IP restrictions - downloads from arbitrary URLs
# RuntimeDirectory and LogsDirectory are auto-excluded from ProtectSystem
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space
ReadWritePaths=/home/django/platform.wafer.space/wafer_space/media

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
