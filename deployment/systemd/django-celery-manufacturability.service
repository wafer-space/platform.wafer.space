[Unit]
Description=platform.wafer.space Celery Worker (Manufacturability)
After=network.target postgresql.service django-gunicorn.service docker.service
Requires=postgresql.service docker.service

[Service]
Type=forking
User=celery-mfg
Group=celery-mfg
WorkingDirectory=/home/django/platform.wafer.space
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
EnvironmentFile=/home/django/platform.wafer.space/.env

# Isolated runtime and log directories (created automatically)
# Sets $RUNTIME_DIRECTORY and $LOGS_DIRECTORY environment variables
RuntimeDirectory=platform.wafer.space-celery-manufacturability
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-celery-manufacturability
LogsDirectoryMode=0750

PIDFile=${RUNTIME_DIRECTORY}/worker.pid

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    worker \
    --loglevel=info \
    --logfile=${LOGS_DIRECTORY}/worker.log \
    --pidfile=${RUNTIME_DIRECTORY}/worker.pid \
    --detach \
    --queues=manufacturability \
    --hostname=manufacturability@%h

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Startup timeout - give celery time to write PID file
TimeoutStartSec=30s

# Security hardening
# NOTE: This service requires Docker socket access, which is root-equivalent.
# Media write needed: saves check.log_file and check.runs_archive after container run.
# RuntimeDirectory and LogsDirectory are auto-excluded from ProtectSystem.
# The celery-mfg user must be in the 'docker' group.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ReadOnlyPaths=/home/django/platform.wafer.space
ReadWritePaths=/home/django/platform.wafer.space/wafer_space/media

# Docker socket access
SupplementaryGroups=docker

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
