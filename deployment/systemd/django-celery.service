[Unit]
Description=platform.wafer.space Celery Worker (Default)
After=network.target postgresql.service django-gunicorn.service
Requires=postgresql.service

[Service]
Type=forking
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
# DJANGO_SETTINGS_MODULE is set in .env file (auto-detected: stage or prod)
EnvironmentFile=/home/django/platform.wafer.space/.env
PIDFile=/run/platform.wafer.space/celery.pid

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    worker \
    --loglevel=info \
    --logfile=/var/log/platform.wafer.space/celery.log \
    --pidfile=/run/platform.wafer.space/celery.pid \
    --detach \
    --queues=default,referrals \
    --hostname=default@%h

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Startup timeout - give celery time to write PID file
TimeoutStartSec=30s

# Runtime directory (automatically created on boot)
RuntimeDirectory=platform.wafer.space
RuntimeDirectoryMode=0755

# Security hardening
# This worker handles email tasks only - no filesystem writes needed (except logs)
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space
ReadWritePaths=/var/log/platform.wafer.space /run/platform.wafer.space

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
