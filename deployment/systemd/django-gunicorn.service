[Unit]
Description=platform.wafer.space Gunicorn Application Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
# DJANGO_SETTINGS_MODULE is set in .env file (auto-detected: stage or prod)
EnvironmentFile=/home/django/platform.wafer.space/.env

ExecStart=/home/django/platform.wafer.space/.venv/bin/gunicorn \
    --workers 4 \
    --worker-class sync \
    --bind unix:/run/platform.wafer.space-gunicorn/gunicorn.sock \
    --access-logfile /var/log/platform.wafer.space-gunicorn/access.log \
    --error-logfile /var/log/platform.wafer.space-gunicorn/error.log \
    --log-level info \
    --timeout 120 \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

# Isolated runtime and log directories (created automatically)
RuntimeDirectory=platform.wafer.space-gunicorn
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-gunicorn
LogsDirectoryMode=0750

# Security hardening
# Gunicorn needs media write for file uploads via Django
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space
ReadWritePaths=/var/log/platform.wafer.space-gunicorn /run/platform.wafer.space-gunicorn /home/django/platform.wafer.space/wafer_space/media

# Restart policy
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
