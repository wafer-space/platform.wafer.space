[Unit]
Description=platform.wafer.space Gunicorn Application Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
# DJANGO_SETTINGS_MODULE is set in .env file (auto-detected: stage or prod)
EnvironmentFile=/home/django/platform.wafer.space/.env

# Isolated runtime and log directories (created automatically)
# Sets $RUNTIME_DIRECTORY and $LOGS_DIRECTORY environment variables
RuntimeDirectory=platform.wafer.space-gunicorn
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-gunicorn
LogsDirectoryMode=0750

ExecStart=/home/django/platform.wafer.space/.venv/bin/gunicorn \
    --workers 4 \
    --worker-class sync \
    --bind unix:${RUNTIME_DIRECTORY}/gunicorn.sock \
    --access-logfile ${LOGS_DIRECTORY}/access.log \
    --error-logfile ${LOGS_DIRECTORY}/error.log \
    --log-level info \
    --timeout 120 \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

# Security hardening
# Gunicorn serves requests only - file writes are handled by Celery workers
# RuntimeDirectory and LogsDirectory are auto-excluded from ProtectSystem
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space

# Restart policy
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
