[Unit]
Description=platform.wafer.space Celery Worker (Maintenance)
After=network.target postgresql.service django-gunicorn.service docker.service
Requires=postgresql.service docker.service

[Service]
Type=forking
User=celery-mfg
Group=celery-mfg
WorkingDirectory=/home/django/platform.wafer.space
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
EnvironmentFile=/home/django/platform.wafer.space/.env

# Isolated runtime and log directories (created automatically)
# Sets $RUNTIME_DIRECTORY and $LOGS_DIRECTORY environment variables
RuntimeDirectory=platform.wafer.space-celery-maintenance
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-celery-maintenance
LogsDirectoryMode=0750

PIDFile=${RUNTIME_DIRECTORY}/worker.pid

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    worker \
    --loglevel=info \
    --logfile=${LOGS_DIRECTORY}/worker.log \
    --pidfile=${RUNTIME_DIRECTORY}/worker.pid \
    --detach \
    --queues=maintenance \
    --hostname=maintenance@%h

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Startup timeout - give celery time to write PID file
TimeoutStartSec=30s

# Security hardening
# NOTE: This service requires Docker socket access for container cleanup.
# No media write needed - orchestration and cleanup tasks only (DB + Docker API).
# RuntimeDirectory and LogsDirectory are auto-excluded from ProtectSystem.
# The celery-mfg user must be in the 'docker' group.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space

# Docker socket access - BindPaths ensures socket is accessible despite ProtectSystem=strict
SupplementaryGroups=docker
BindPaths=/var/run/docker.sock

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
