[Unit]
Description=platform.wafer.space Celery Worker (mail:ro:email)
After=network.target postgresql.service django-gunicorn.service
Requires=postgresql.service

[Service]
Type=forking
User=www-data
Group=www-data
WorkingDirectory=/home/django/platform.wafer.space
# DJANGO_SETTINGS_MODULE is set in .env file (auto-detected: stage or prod)
EnvironmentFile=/home/django/platform.wafer.space/.env

# Isolated runtime and log directories (created automatically)
# Sets $RUNTIME_DIRECTORY and $LOGS_DIRECTORY environment variables
RuntimeDirectory=platform.wafer.space-celery-mail-ro-email
RuntimeDirectoryMode=0750
LogsDirectory=platform.wafer.space-celery-mail-ro-email
LogsDirectoryMode=0750

PIDFile=/run/platform.wafer.space-celery-mail-ro-email/worker.pid

ExecStart=/home/django/platform.wafer.space/.venv/bin/celery \
    -A config \
    worker \
    --loglevel=info \
    --logfile=${LOGS_DIRECTORY}/worker.log \
    --pidfile=${RUNTIME_DIRECTORY}/worker.pid \
    --detach \
    --queues=mail:ro:email \
    --hostname=mail-ro-email@%h

ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

# Startup timeout - give celery time to write PID file
TimeoutStartSec=30s

# Security hardening
# Queue: mail:ro:email - email tasks (send_tos_* via Mailgun API)
# Network: mail - HTTPS to Mailgun API (api.mailgun.net)
# Filesystem: ro - read-only access to application
# Intended ports: 443 (see issue #209)
# Note: No IP restrictions - Mailgun doesn't publish static API IPs
# RuntimeDirectory and LogsDirectory are auto-excluded from ProtectSystem
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/django/platform.wafer.space

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
