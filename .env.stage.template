# Staging Environment Configuration for test-platform.wafer.space
# This file is used for the staging deployment to test features before production
# Edit the values below with your staging secrets

# Django Core Settings
# ------------------------------------------------------------------------------
# Note: systemd EnvironmentFile format - no quotes around values
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_GENERATED_BY_COMMAND_BELOW
DJANGO_SETTINGS_MODULE=config.settings.stage
DJANGO_ALLOWED_HOSTS=test-platform.wafer.space
DJANGO_ADMIN_URL=admin-staging/
SITE_URL=https://test-platform.wafer.space

# DJANGO_SECRET_KEY should be generated using:
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Database
# ------------------------------------------------------------------------------
# DATABASE_URL is automatically added by the setup script
# Format: postgresql://user:password@localhost:5432/wafer_space_staging

# Email Configuration (Mailgun)
# ------------------------------------------------------------------------------
# Sign up at https://www.mailgun.com/
# Can use same Mailgun domain as production or create separate staging domain
# MAILGUN_API_KEY is automatically populated from secrets repository by setup script
MAILGUN_API_KEY=YOUR_MAILGUN_API_KEY_HERE
MAILGUN_DOMAIN=mg.wafer.space
MAILGUN_API_URL=https://api.mailgun.net/v3
DJANGO_DEFAULT_FROM_EMAIL=wafer.space Online Platform <noreply@test-platform.wafer.space>
DJANGO_SERVER_EMAIL=wafer.space Online Platform <noreply@test-platform.wafer.space>
DJANGO_EMAIL_SUBJECT_PREFIX=[wafer.space Staging]

# OAuth Providers - Staging
# ------------------------------------------------------------------------------
# IMPORTANT: Staging has separate OAuth applications from dev and production
# All client IDs and secrets are required from environment variables

# GitHub OAuth Application (Staging)
# Create at: https://github.com/settings/developers
# Homepage URL: https://test-platform.wafer.space
# Authorization callback URL: https://test-platform.wafer.space/accounts/github/login/callback/
# Secrets are automatically populated from /home/django/.secrets-stage/ by setup script
GITHUB_CLIENT_ID=YOUR_STAGING_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# GitLab OAuth Application (Staging)
# Create at: https://gitlab.com/-/profile/applications
# Redirect URI: https://test-platform.wafer.space/accounts/gitlab/login/callback/
# Scopes: read_user, email
# Secrets are automatically populated from /home/django/.secrets-stage/ by setup script
GITLAB_CLIENT_ID=YOUR_STAGING_GITLAB_CLIENT_ID
GITLAB_CLIENT_SECRET=YOUR_GITLAB_CLIENT_SECRET

# Google OAuth Application (Staging)
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: https://test-platform.wafer.space/accounts/google/login/callback/
# Secrets are automatically populated from /home/django/.secrets-stage/ by setup script
GOOGLE_CLIENT_ID=YOUR_STAGING_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# LinkedIn OAuth Application (Staging)
# Create at: https://www.linkedin.com/developers/apps
# Redirect URIs: https://test-platform.wafer.space/accounts/oidc/linkedin/login/callback/
# Secrets are automatically populated from /home/django/.secrets-stage/ by setup script
LINKEDIN_CLIENT_ID=YOUR_STAGING_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET

# Discord OAuth Application (Staging)
# Create at: https://discord.com/developers/applications
# Redirect URIs: https://test-platform.wafer.space/accounts/discord/login/callback/
# Secrets are automatically populated from /home/django/.secrets-stage/ by setup script
DISCORD_CLIENT_ID=YOUR_STAGING_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Security Settings
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=60
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Celery Configuration
# ------------------------------------------------------------------------------
# SQLAlchemy broker URL - automatically set by setup script from DATABASE_URL
# Format: sqla+postgresql://user:password@host:port/database
# CELERY_BROKER_URL will be auto-generated from DATABASE_URL
