# Staging Environment Configuration for test-platform.wafer.space
# This file is automatically copied to .env during deployment setup
#
# SECRETS REPOSITORY:
# Staging secrets are stored in: git+ssh://github.com/mithro/test-platform.wafer.space-secrets.git
# The deployment script clones this to: /home/django/.secrets/
# Both staging and production use the same path (/home/django/.secrets/),
# but clone from different repositories.

# Django Core Settings
# ------------------------------------------------------------------------------
# Note: systemd EnvironmentFile format - no quotes around values
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_GENERATED_BY_COMMAND_BELOW
DJANGO_SETTINGS_MODULE=config.settings.stage
# Required: comma-separated host allowlist, NO spaces (parsed by env.list).
# Must include the hypervisor-specific origin names served direct-to-origin.
DJANGO_ALLOWED_HOSTS=test-platform.wafer.space,buddy.test-platform.wafer.space,doc.test-platform.wafer.space,test-platform.buddy.mithis.com,test-platform.doc.mithis.com,test-platform-wafer-space.buddy.mithis.com,test-platform-wafer-space.doc.mithis.com

# Database
# ------------------------------------------------------------------------------
# DATABASE_URL is automatically added by the setup script
# Uses Unix socket for security: postgres://user:password@/dbname?host=/var/run/postgresql

# Email Configuration (Mailgun)
# ------------------------------------------------------------------------------
MAILGUN_API_KEY=YOUR_MAILGUN_API_KEY_HERE

# OAuth Providers
# ------------------------------------------------------------------------------
# GitHub OAuth Application
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# GitLab OAuth Application
GITLAB_CLIENT_SECRET=YOUR_GITLAB_CLIENT_SECRET

# Google OAuth Application
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# LinkedIn OAuth Application
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET

# Discord OAuth Application
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# API Tokens
# ------------------------------------------------------------------------------
# GitHub API Token (for repository access)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Security Settings
# ------------------------------------------------------------------------------

# Celery Configuration
# ------------------------------------------------------------------------------
# SQLAlchemy broker URL - automatically set by setup script from DATABASE_URL
# Format: sqla+postgresql://user:password@/dbname?host=/var/run/postgresql
# CELERY_BROKER_URL will be auto-generated from DATABASE_URL

# Display Settings
# ------------------------------------------------------------------------------
# Deploy target identifier shown in page footer (optional)
DEPLOY_TARGET=staging
