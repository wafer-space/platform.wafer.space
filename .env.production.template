# Production Environment Configuration for platform.wafer.space
# This file is automatically copied to .env during deployment setup
# Edit the values below with your production secrets

# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_GENERATED_BY_COMMAND_BELOW
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=platform.wafer.space
DJANGO_ADMIN_URL=admin/

# DJANGO_SECRET_KEY is automatically generated by the setup script (03-setup-database.sh)
# If you need to regenerate it manually:
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Database
# ------------------------------------------------------------------------------
# DATABASE_URL is automatically added by the setup script

# Email Configuration (Mailgun)
# ------------------------------------------------------------------------------
# Sign up at https://www.mailgun.com/
MAILGUN_API_KEY=YOUR_MAILGUN_API_KEY_HERE
MAILGUN_DOMAIN=mg.platform.wafer.space
MAILGUN_API_URL=https://api.mailgun.net/v3
DJANGO_DEFAULT_FROM_EMAIL=platform.wafer.space <bot@wafer.space>
DJANGO_SERVER_EMAIL=platform.wafer.space <bot@wafer.space>

# OAuth Providers - Production
# ------------------------------------------------------------------------------
# GitHub OAuth Application
# Create at: https://github.com/settings/developers
# Homepage URL: https://platform.wafer.space
# Authorization callback URL: https://platform.wafer.space/accounts/github/login/callback/
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# GitLab OAuth Application
# Create at: https://gitlab.com/-/profile/applications
# Redirect URI: https://platform.wafer.space/accounts/gitlab/login/callback/
# Scopes: read_user
GITLAB_CLIENT_ID=YOUR_GITLAB_CLIENT_ID
GITLAB_CLIENT_SECRET=YOUR_GITLAB_CLIENT_SECRET

# Google OAuth Application
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: https://platform.wafer.space/accounts/google/login/callback/
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# LinkedIn OAuth (Optional)
# Create at: https://www.linkedin.com/developers/apps
# LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
# LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET

# Security Settings
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Celery Configuration
# ------------------------------------------------------------------------------
# Uses PostgreSQL as broker by default (via DATABASE_URL)
# No additional configuration needed
